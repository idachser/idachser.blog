log_format json_main escape=json
  '{'
    '"time":"$time_iso8601",'
    '"ip":"$remote_addr",'
    '"host":"$host",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"proto":"$server_protocol",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"req_time":$request_time,'
    '"upstream_time":"$upstream_response_time",'
    '"referer":"$http_referer",'
    '"ua":"$http_user_agent"'
  '}';

access_log /var/log/nginx/json/access.json.log json_main;

map $request_uri $bad_request {
    default                                                  0;
    "~*^/wp-"                                                1;
    "~*^/(wordpress|phpmyadmin|pma|adminer|vendor|cgi-bin)"  1;
    "~*\.(php|phtml|asp|aspx|jsp|cgi|pl)($|\?)"              1;
    "~*/\.(env|git|aws|ssh|svn)"                             1;
    "~*[?&]rest_route="                                      1;
}

limit_req_zone $binary_remote_addr zone=admin:10m rate=30r/m;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    server_name idachser.com www.idachser.com;

    if ($bad_request) {
        return 444;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name idachser.com www.idachser.com;

    ssl_certificate /etc/letsencrypt/live/idachser.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/idachser.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 20M;

    if ($bad_request) {
        return 444;
    }

    location /static/ {
        alias /app/staticfiles/;
    }

    location /media/ {
        alias /app/uploads/;
    }

    location /${ADMIN_URL} {
        auth_basic "restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;

        limit_req zone=admin burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
